# Internal tool; this build-time flag is not authentication.
# Template only: Vite does not load .env.example.
# For local development, put the flag in .env.development.local and restart Vite.
VITE_ENABLE_DATA_COLLECTION=true
VITE_HAND_DEBUG=false

# Enable the local recognition lab and its V1 model in development.
VITE_ENABLE_RECOGNITION_LAB=false
